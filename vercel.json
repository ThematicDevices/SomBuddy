{
  "buildCommand": "vite build",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {
    "api/claude-proxy.ts": {
      "maxDuration": 60
    },
    "api/update-prices.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/update-prices",
      "schedule": "0 23 * * 0"
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ]
}
